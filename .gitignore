# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# env variables

.env
.env.production
.env.development

# Ignore for WebStorm configuration
.idea
# shadcn registry output (built from registry.json by `shadcn build`)
/public/r

# generated-code typecheck fixtures (__tests__/form-code.spec.ts)
/__tests__/.generated
